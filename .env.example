# Любой OpenAI-совместимый endpoint.
# Локально и бесплатно (Ollama):
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b-instruct

# OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
